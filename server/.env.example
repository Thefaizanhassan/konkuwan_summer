# Server
NODE_ENV=development
PORT=5500

# Database (PostgreSQL) – will be used later
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konkuwan_herbs
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=change_this_to_a_strong_random_string
JWT_EXPIRE_IN=24h
JWT_REFRESH_SECRET=change_this_to_a_strong_random_string
JWT_REFRESH_EXPIRE_IN=7d

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880    # 5 MB

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100