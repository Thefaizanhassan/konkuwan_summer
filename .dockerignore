# Keeping node_modules out matters most: without this, the build context is
# hundreds of megabytes and the COPY would overwrite the Alpine-built,
# production-only tree with whatever is on the developer's machine.
**/node_modules
**/dist
**/.vite
 
# Secrets must never enter an image layer — they are readable in the history
# even if a later layer deletes them.
**/.env
**/.env.*
!**/.env.example
 
.git
.gitignore
**/*.patch
**/npm-debug.log*
**/.DS_Store
 
# Cloudflare-specific; irrelevant to the container build.
.wrangler
wrangler.jsonc
worker.js
 
# Docs and scratch
*.md
!README.md
client/stats.html
coverage
.vscode
.idea