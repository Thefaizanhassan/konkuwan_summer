# ── Dependencies ──────────────────────────────────
node_modules/

# ── Environment files ─────────────────────────────
# Broad glob: the previous list missed "client/.env.local " (trailing space),
# which left a real file tracked in git.
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────
server/logs/
*.log

# ── Uploads (keep empty directories with .gitkeep) ──
server/uploads/*
!server/uploads/.gitkeep

# ── Build output ─────────────────────────────────
client/dist/
client/build/

# ── Test coverage ────────────────────────────────
coverage/
.nyc_output/

# ── IDE & OS ─────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Cache & temporary files ──────────────────────
.eslintcache
*.tsbuildinfo
vite.config.js.timestamp-*

# ── Supabase local (if used) ─────────────────────
.supabase/

# ── Docker (optional) ────────────────────────────
# docker-compose.override.yml

# ── Misc ─────────────────────────────────────────
*.pem
*.key
*.cert

# ── Secrets / keys ───────────────────────────────
# supabase-service-key.json

# Cloudflare Wrangler
.wrangler/