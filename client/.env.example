# Copy to .env.local and fill in. Vite inlines every VITE_* value into the
# JavaScript bundle at BUILD time, so these are PUBLIC. Only the anon key
# belongs here — never the service-role key.

VITE_SUPABASE_URL=https://uyngkwslpqgswcmkupin.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xvRoWLrkZc_FbcSNoHj9Cw_68fCM7nD

# Leave unset for the single-Worker deployment: the client defaults to the
# same-origin /api. Set it only when the API is on a different host.
# VITE_API_URL=https://api.example.com/api